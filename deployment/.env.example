# ===== REQUIRED - must be set in .env =====

# Database
DB_ROOT_PASSWORD=your-secure-password
DB_NAME=soppadop_db
DB_USER=soppadop
DB_PASSWORD=your-secure-password
DB_PORT=3307

# Flask
FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=generate-a-random-secret-key
JWT_SECRET_KEY=generate-a-random-secret-key

# CORS
CORS_ORIGINS=http://localhost

# Super Admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=

# ===== OPTIONAL =====

# Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Backup
BACKUP_DIR=/app/backups
BACKUP_RETENTION=30
BACKUP_AUTO_ENABLED=false
BACKUP_AUTO_INTERVAL_HOURS=24
